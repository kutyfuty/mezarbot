# Zorunlu: Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Opsiyonel — boş bırakılan özellik kapanır, bot çökmez
# Yapay zekâ sohbeti + çeviri (ücretsiz: https://console.groq.com)
GROQ_API_KEY=
# /ciz resim çizimi (https://replicate.com)
REPLICATE_API_TOKEN=
# Spotify Web API (boşsa Spotify linkleri herkese açık embed sayfasından okunur)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
